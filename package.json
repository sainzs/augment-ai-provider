{
  "name": "augment-ai-provider",
  "version": "0.1.0",
  "description": "AI SDK provider for Augment Code (direct HTTP, no subprocess). Works with pi, OpenCode, OpenCode 2, and AI SDK v3 hosts.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./sync": "./bin/sync-models.mjs"
  },
  "bin": {
    "augment-ai-provider": "./bin/sync-models.mjs"
  },
  "files": [
    "index.js",
    "bin/",
    "integrations/",
    "test/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/live-test.mjs",
    "sync": "node bin/sync-models.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@augmentcode/auggie-sdk": "0.2.0"
  },
  "devDependencies": {
    "ai": "^6.0.258",
    "zod": "^4.4.3"
  },
  "keywords": [
    "ai-sdk",
    "provider",
    "augment",
    "auggie",
    "pi",
    "opencode",
    "llm",
    "claude",
    "gpt"
  ],
  "author": "Santiago Sainz",
  "license": "MIT"
}
